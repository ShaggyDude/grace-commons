# Beacon Clinical Research — environment configuration
#
# The demo runs with NO .env file at all.
# Copy this file to .env and fill in values only when you want real email delivery.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your SMTP credentials
#   deno task start

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Absolute base URL used to build accept links in invitation emails.
# Defaults to http://localhost:8000 when unset.
# BASE_URL=https://beacon.example.com

# TCP port the server listens on (default: 8000).
# PORT=8000

# ---------------------------------------------------------------------------
# SMTP — all optional; omit SMTP_HOST to disable email delivery entirely.
# ---------------------------------------------------------------------------

# Hostname of your SMTP server.
# SMTP_HOST=smtp.example.com

# SMTP port (default: 587 for STARTTLS).
# SMTP_PORT=587

# Set to "true" to use TLS-from-connect (port 465). Default: false (STARTTLS).
# SMTP_SECURE=false

# SMTP auth credentials.
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password

# From address shown in invitation emails.
# SMTP_FROM=Beacon <no-reply@beacon.example.com>
