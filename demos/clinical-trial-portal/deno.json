{
  "nodeModulesDir": "auto",
  "tasks": {
    "migrate": "deno run -A --env-file=.env scripts/migrate.ts",
    "seed":    "deno run -A --env-file=.env scripts/seed.ts",
    "css":     "deno run -A npm:@tailwindcss/cli -i styles/inkset.css -o static/styles.css",
    "start":   "(deno task css --watch & deno run -A --env-file=.env main.ts)",
    "verify":  "deno run -A --env-file=.env scripts/verify.ts",
    "test":    "deno test -A",
    "dev":     "deno task migrate && deno task seed && (deno task css --watch & deno run -A --env-file=.env --watch main.ts)",
    "all":     "deno task migrate && deno task seed && deno task start"
  },
  "imports": {
    "tailwindcss":              "npm:tailwindcss@^4",
    "@tailwindcss/typography":  "npm:@tailwindcss/typography",
    "hono":                    "jsr:@hono/hono@^4",
    "hono/cookie":             "jsr:@hono/hono@^4/cookie",
    "hono/jsx":                "jsr:@hono/hono@^4/jsx",
    "hono/jsx/jsx-runtime":    "jsr:@hono/hono@^4/jsx/jsx-runtime",
    "hono/jsx/jsx-dev-runtime":"jsr:@hono/hono@^4/jsx/jsx-dev-runtime",
    "hono/":                   "jsr:@hono/hono@^4/",
    "nodemailer":              "npm:nodemailer@^6",
    "sqlite":                  "jsr:@db/sqlite@^0.12",
    "argontwo":                "jsr:@denosaurs/argontwo@^0.2",
    "std/":                    "jsr:@std/"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  }
}
