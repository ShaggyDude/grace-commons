# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL UNSET for zero-setup local dev: the app uses an embedded
# PostgreSQL (pglite) under ./data/pg — no Docker, no Postgres install.
#
# Set DATABASE_URL to a real PostgreSQL to use node-postgres (pg) instead.
# IMPORTANT (BUILD_PLAN Decision 2 / §4.2): for the write path, this MUST be a
# direct/SESSION connection string, NOT a transaction-pooled one (PgBouncer
# transaction mode / a serverless pooler), or pg_advisory_xact_lock silently
# stops holding and the global audit chain can fork.
# DATABASE_URL=postgres://user:pass@host:5432/beacon

# Cookie name for the opaque DB-backed session token.
SESSION_COOKIE=beacon_session

# ── SMTP (optional; invitation delivery) ─────────────────────────────────────
# Unset → invitation links are shown in-app (the default, same as render 1).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Beacon <no-reply@beacon.clinical>
