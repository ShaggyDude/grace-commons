# Conformance validator tooling — kept private for now. Reversible: delete this
# block to reveal. (PLAN.md is untracked via `git rm --cached` so it also leaves
# the repo tip; it remains in past history unless history is rewritten.)
tools/conformance/

# Demos — committed source, but exclude build artifacts and runtime data.
demos/*/node_modules/
demos/*/.deno/
demos/*/data/
demos/*/public/styles.css
